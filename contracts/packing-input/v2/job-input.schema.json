{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:3d-packing:packing-job-input:2",
  "title": "Packing job input",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "description": "Optional. When sent and not the current version, the request is rejected with 409."
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "title": "Models",
      "x-widget": "project-files",
      "x-acceptedFormats": ["OBJ"],
      "x-maxTotalCopies": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fileId"],
        "properties": {
          "fileId": { "type": "string", "format": "uuid" },
          "fileName": { "type": "string", "readOnly": true },
          "copies": { "type": "integer", "minimum": 1, "maximum": 100, "default": 1, "title": "Copies" }
        }
      }
    },
    "maxRuntimeSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 7200,
      "default": 60,
      "title": "Time limit",
      "description": "How long the solver may search",
      "x-unit": "s"
    },
    "parameters": {
      "type": "object",
      "title": "Engine options",
      "additionalProperties": false,
      "default": {},
      "properties": {
        "container": {
          "type": "object",
          "title": "Container",
          "description": "Size of each container, in the units of the models. The solver uses as few containers as it can.",
          "additionalProperties": false,
          "default": {},
          "properties": {
            "width": { "type": "number", "exclusiveMinimum": 0, "default": 200, "title": "Width (X)" },
            "length": { "type": "number", "exclusiveMinimum": 0, "default": 200, "title": "Length (Y)" },
            "height": { "type": "number", "exclusiveMinimum": 0, "default": 200, "title": "Height (Z)" }
          }
        },
        "gap": {
          "type": "number",
          "minimum": 0,
          "default": 0,
          "title": "Gap",
          "description": "Minimum distance between the surfaces of two models, in the units of the models. Container walls need none."
        },
        "algorithm": {
          "type": "string",
          "enum": ["anneal", "constructive"],
          "default": "anneal",
          "title": "Algorithm",
          "description": "anneal: simulated annealing. constructive: randomized insertion with backtracking."
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "default": 42,
          "title": "Random seed"
        }
      }
    }
  }
}
