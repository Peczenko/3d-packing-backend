FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_B64=
FIREBASE_ADMIN_ENABLED=false

DB_NAME=packing
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_PORT=5432

AZURITE_BLOB_PORT=10000
STORAGE_CONTAINER_NAME=models

STORAGE_DOWNLOAD_URL_TTL=5m

MAX_UPLOAD_FILE_SIZE=100MB

# Set to point at a real storage account instead of the emulator. Leave unset otherwise.
# AZURE_STORAGE_CONNECTION_STRING=

# Set false to run with no object storage at all: the file endpoints return 503 and
# everything else keeps working.
# STORAGE_ENABLED=true

# --- App --------------------------------------------------------------------
APP_PORT=8080

# --- Email & error alerting ---------------------------------------------------
# Off by default: mail is logged instead of sent, so no key and no quota are needed.
EMAIL_ENABLED=false

# Brevo transactional API key. Generate a fresh one in the Brevo dashboard; never commit it.
# Only required when EMAIL_ENABLED=true.
BREVO_API_KEY=

# Must be on the Brevo-authenticated domain (3dpacking.dev) or every send is rejected.
EMAIL_FROM_ADDRESS=noreply@3dpacking.dev
EMAIL_FROM_NAME=3D Packing

# Comma-separated. Empty means no 5xx alerts are sent at all.
ALERT_RECIPIENTS=

# One email per distinct failure per cooldown, and never more than this many per hour.
# Brevo's free tier allows 300 a day, so the ceiling matters.
ALERT_COOLDOWN=15m
ALERT_MAX_PER_HOUR=20

# --- Storage browser (optional) ----------------------------------------------
# A web GUI for browsing Azurite's blobs, off by default. Start it with:
#   docker compose --profile tools up -d storage-ui
# then open http://localhost:5572. Basic-auth protected since the port is published.
STORAGE_UI_PORT=5572
STORAGE_UI_USER=admin
STORAGE_UI_PASSWORD=admin
