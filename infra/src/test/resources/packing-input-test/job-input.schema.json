{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:3d-packing:packing-job-input:test",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "schemaVersion": { "type": "integer" },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "x-acceptedFormats": ["OBJ", "STL"],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fileId"],
        "properties": {
          "fileId": { "type": "string", "format": "uuid" },
          "fileName": { "type": "string", "readOnly": true },
          "copies": { "type": "integer", "minimum": 1, "maximum": 100, "default": 1 }
        }
      }
    },
    "maxRuntimeSeconds": { "type": "integer", "minimum": 1, "maximum": 600, "default": 30 },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "properties": {
        "seed": { "type": "integer", "minimum": 0, "default": 7 },
        "buildVolume": {
          "type": "object",
          "additionalProperties": false,
          "required": ["widthMm"],
          "default": { "widthMm": 220 },
          "properties": { "widthMm": { "type": "integer", "minimum": 1 } }
        }
      }
    }
  }
}
